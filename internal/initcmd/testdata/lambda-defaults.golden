# citadel.yml — generated by `citadel init` (citadel vTEST).
# Single source of truth for deploying smaug to AWS Lambda (container image).
#
# citadel builds and pushes the image to the "<name>-<env>-repo" ECR repository
# and points the function at it. Prerequisites: that repository and the
# function must already exist (create them with your CDK stack).

name: smaug
region: eu-west-1
runtime: lambda

# lambda.functionName is omitted: citadel uses the "<name>-<env>" convention
# (smaug-dev). Set it only to override; "{env}" is substituted.
# lambda:
#   functionName: "smaug-{env}"

# One entry per environment you deploy with `citadel deploy --env <name>`.
environments:
  dev:
    account: "111111111111"
  prod:
    account: "111111111111"

# Non-secret env vars set on the function by `citadel deploy`, safe to commit.
# A name may not also be in secrets.
# env:
#   LOG_LEVEL: info

# Secret env-var NAMES (never values), synced to SSM by
# `citadel deploy --env-file <file>` under /<name>-<env>/<VAR_NAME>.
# secrets:
#   - DATABASE_URL
