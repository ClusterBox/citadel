# citadel.yml — generated by `citadel init` (citadel vTEST).
# Single source of truth for deploying my-api to ECS Fargate.
#
# Every per-environment AWS resource is namespaced "<name>-<env>"
# (my-api-staging-cluster, -service, -repo, log group, SSM prefix),
# so environments stay isolated even inside one AWS account.

name: "my-api"
region: us-east-1
runtime: ecs

# Fargate task settings. cpu is in CPU units (256 = 0.25 vCPU), memory in MiB.
# health_check_path must return HTTP 200 once the app is ready.
container:
  port: 8080
  cpu: 512
  memory: 1024
  health_check_path: "/healthz"
  health_check_grace_period: 60

# One entry per environment you deploy with `citadel deploy --env <name>`.
# min_capacity is the desired task count; max_capacity caps autoscaling.
environments:
  "staging":
    account: "111111111111"
    min_capacity: 1
    max_capacity: 2

# Secret env-var NAMES (never values). `citadel deploy --env-file <file>`
# syncs their values to SSM Parameter Store as SecureString under
# /<name>-<env>/<VAR_NAME>, and the task receives them as env vars.
secrets:
  - DATABASE_URL
  - JWT_SECRET

# Non-secret env vars, safe to commit. A name may not also be in secrets.
# env:
#   LOG_LEVEL: info

# Optional blocks: queues (SQS access), ecs (adopt an existing
# cluster/service), vpc, cloudfront. See the citadel README.

# Optional: declare the deploy as explicit steps (default: ssm-sync, build,
# cdk, deploy, wait). Built-ins are `uses: citadel/<name>`; custom steps are
# run: (shell), task: (one-off ECS task in the new image) and http: (health
# check). Variables: ${env} ${name} ${image} ${sha} ${region} ${account}.
# pipeline:
#   - uses: citadel/ssm-sync
#   - uses: citadel/build
#   - name: migrate
#     task: npx prisma migrate deploy
#   - uses: citadel/cdk
#   - uses: citadel/deploy
#   - uses: citadel/wait
#   - name: smoke
#     http: https://my-api-${env}.example.com/health
#     rollback_on_failure: true
